import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';
import { getBlockedIPs, logSuspiciousActivity, logRequest } from '@/lib/anti-ddos/vercel-adapter';

// In-memory blocked IPs set for faster lookups
let blockedIPs = new Set<string>();
let lastBlockedIPsUpdate = 0;

// Rate limiting storage
const rateLimitMap = new Map<string, { count: number; resetTime: number }>();

// Get real IP address
function getRealIP(request: NextRequest): string {
  const forwarded = request.headers.get('x-forwarded-for');
  const realIP = request.headers.get('x-real-ip');
  const cfConnectingIP = request.headers.get('cf-connecting-ip');
  
  if (cfConnectingIP) return cfConnectingIP;
  if (realIP) return realIP;
  if (forwarded) return forwarded.split(',')[0].trim();
  
  return '127.0.0.1'; // Fallback for localhost
}

// Clean up old rate limit entries
function cleanupRateLimit() {
  const now = Date.now();
  for (const [ip, data] of rateLimitMap.entries()) {
    if (now > data.resetTime) {
      rateLimitMap.delete(ip);
    }
  }
}

// Check rate limit
function checkRateLimit(ip: string, limit: number = 100, windowMs: number = 60000): boolean {
  cleanupRateLimit();
  
  const now = Date.now();
  
  if (!rateLimitMap.has(ip)) {
    rateLimitMap.set(ip, { count: 1, resetTime: now + windowMs });
    return true;
  }
  
  const data = rateLimitMap.get(ip)!;
  
  if (now > data.resetTime) {
    // Reset window
    data.count = 1;
    data.resetTime = now + windowMs;
    return true;
  }
  
  data.count++;
  
  if (data.count > limit) {
    console.log(`🚨 Rate limit exceeded for IP: ${ip} (${data.count} requests)`);
    return false;
  }
  
  return true;
}

// Load blocked IPs from Supabase (cache for 30 seconds)
async function loadBlockedIPs() {
  const now = Date.now();
  if (now - lastBlockedIPsUpdate < 30000) return; // Cache for 30 seconds
  
  try {
    const ips = await getBlockedIPs();
    blockedIPs = new Set(ips);
    lastBlockedIPsUpdate = now;
  } catch (error) {
    console.error('Error loading blocked IPs:', error);
  }
}

export async function middleware(request: NextRequest) {
  const ip = getRealIP(request);
  const url = request.nextUrl.pathname;
  const origin = request.nextUrl.origin;
  
  // Skip middleware for static files and internal Next.js routes
  if (
    url.startsWith('/_next/') ||
    url.startsWith('/api/_next/') ||
    url.includes('.') && !url.startsWith('/api/') ||
    url.startsWith('/dev')
  ) {
    return NextResponse.next();
  }
  
  // Load blocked IPs periodically
  await loadBlockedIPs();
  
  // Check if IP is blocked by anti-DDoS system
  if (blockedIPs.has(ip)) {
    console.log(`🚫 Anti-DDoS blocked IP: ${ip} -> ${url}`);
    return new NextResponse(
      `
      <!DOCTYPE html>
      <html>
      <head>
        <title>🛡️ Anti-DDoS Protection</title>
        <meta charset="utf-8">
        <script src="https://cdn.tailwindcss.com"></script>
      </head>
      <body class="min-h-screen bg-black flex items-center justify-center p-4">
        <div class="max-w-2xl w-full">
          <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-white">Dinletiyo</h1>
          </div>
          
          <div class="bg-black border-2 border-red-500 rounded-2xl p-8 shadow-2xl">
            <div class="text-center space-y-6">
              <div class="text-6xl mb-4">🛡️</div>
              
              <h1 class="text-5xl font-bold text-red-500 mb-4">
                ANTI-DDOS KORUMASI
              </h1>
              
              <div class="bg-black border border-red-500 rounded-lg p-6 space-y-4">
                <p class="text-xl text-red-400">
                  IP adresiniz <strong class="text-red-500">DDoS saldırısı</strong> nedeniyle otomatik olarak engellenmiştir.
                </p>
                
                <div class="bg-black border border-red-600 rounded p-3">
                  <p class="font-mono text-red-400 text-lg">
                    IP: <span class="text-red-500 font-bold">${ip}</span>
                  </p>
                  <p class="font-mono text-red-400 text-lg">
                    Tarih: <span class="text-red-500">${new Date().toLocaleString('tr-TR')}</span>
                  </p>
                  <p class="font-mono text-red-400 text-lg">
                    Sebep: <span class="text-red-500">Anormal trafik tespit edildi</span>
                  </p>
                </div>
                
                <div class="border-t border-red-500 pt-4">
                  <p class="text-red-400 font-semibold text-lg">
                    ⚠️ Bu engelleme otomatik olarak kaldırılabilir.
                  </p>
                  <p class="text-red-500 text-lg mt-2">
                    Normal kullanım için <strong>10-30 dakika</strong> bekleyiniz.
                  </p>
                </div>
              </div>
              
              <div class="bg-black border border-red-600 rounded-lg p-4">
                <p class="text-red-400 text-lg">
                  🤖 <strong>Bozkurt Anti-DDoS:</strong> Sitemizi korumak için gelişmiş güvenlik sistemi aktif.
                </p>
              </div>
              
              <div class="pt-6 border-t border-red-500">
                <p class="text-red-500 text-sm">
                  Dinletiyo Company  Ergili 2026
                </p>
              </div>
            </div>
          </div>
        </div>
      </body>
      </html>
      `,
      { 
        status: 403,
        headers: { 
          'Content-Type': 'text/html; charset=utf-8',
          'X-Blocked-Reason': 'Anti-DDoS Protection'
        }
      }
    );
  }
  
  // Rate limiting
  const isAPIRoute = url.startsWith('/api/');
  const isLocalhost = ip === '127.0.0.1' || ip === '::1' || ip === '::ffff:127.0.0.1';
  
  // Localhost için daha yüksek limitler
  const limit = isLocalhost ? (isAPIRoute ? 50 : 100) : (isAPIRoute ? 10 : 20);
  const windowMs = isLocalhost ? 30000 : 10000; // Localhost için 30 saniye window
  
  if (!checkRateLimit(ip, limit, windowMs)) {
    console.log(`⚠️ Rate limit exceeded: ${ip} -> ${url}`);
    
    // Log suspicious activity
    await logSuspiciousActivity(ip, url, 'RATE_LIMIT_EXCEEDED');
    
    return new NextResponse('Too Many Requests - Anti-DDoS Protection Active', { 
      status: 429,
      headers: {
        'Retry-After': '60',
        'X-RateLimit-Limit': limit.toString(),
        'X-RateLimit-Remaining': '0',
        'X-RateLimit-Reset': (Date.now() + windowMs).toString(),
        'X-Protected-By': 'Bozkurt Anti-DDoS'
      }
    });
  }
  
  // Original IP ban check (keep existing functionality)
  try {
    let checkIP = ip;
    if (ip === '127.0.0.1' || ip === '::1' || ip === '::ffff:127.0.0.1') {
      checkIP = '127.0.0.1';
    }
    
    const response = await fetch(`${origin}/api/ip-ban`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'check', ip: checkIP })
    });
    
    if (!response.ok) {
      console.log('IP ban API yanıt vermedi, devam ediliyor...');
      return NextResponse.next();
    }
    
    const data = await response.json();
    console.log('IP ban kontrol:', { originalIP: ip, checkIP, banned: data.banned });
    
    if (data.banned) {
      return new NextResponse(
        `
        <!DOCTYPE html>
        <html>
        <head>
          <title>Erişim Engellendi</title>
          <meta charset="utf-8">
          <script src="https://cdn.tailwindcss.com"></script>
        </head>
        <body class="min-h-screen bg-black flex items-center justify-center p-4">
          <div class="max-w-2xl w-full">
            <div class="text-center mb-8">
              <h1 class="text-4xl font-bold text-white">Dinletiyo</h1>
            </div>
            
            <div class="bg-black border-2 border-red-500 rounded-2xl p-8 shadow-2xl">
              <div class="text-center space-y-6">
                <div class="text-6xl mb-4">🚫</div>
                
                <h1 class="text-5xl font-bold text-red-500 mb-4">
                  ERİŞİM ENGELLENDİ
                </h1>
                
                <div class="bg-black border border-red-500 rounded-lg p-6 space-y-4">
                  <p class="text-xl text-red-400">
                    IP adresiniz site yönetim kurallarına göre <strong class="text-red-500">kalıcı olarak engellenmiştir.</strong>
                  </p>
                  
                  <div class="bg-black border border-red-600 rounded p-3">
                    <p class="font-mono text-red-400 text-lg">
                      IP: <span class="text-red-500 font-bold">${ip}</span>
                    </p>
                    <p class="font-mono text-red-400 text-lg">
                      Tarih: <span class="text-red-500">${new Date().toLocaleString('tr-TR')}</span>
                    </p>
                  </div>
                  
                  <div class="border-t border-red-500 pt-4">
                    <p class="text-red-400 font-semibold text-lg">
                      ⚠️ Bu ağdan hiçbir cihaz siteye erişemez.
                    </p>
                    <p class="text-red-500 text-lg mt-2 font-bold">
                      Giriş denemesi tespit edilirse IP adresi <strong>Jandarma Siber</strong> ile paylaşılacaktır.
                    </p>
                  </div>
                </div>
                
                <div class="bg-black border border-red-600 rounded-lg p-4">
                  <p class="text-red-400 text-lg">
                    📞 <strong>Destek:</strong> Bu kararın yanlış olduğunu düşünüyorsanız sistem yöneticisi ile iletişime geçin.
                  </p>
                </div>
                
                <div class="pt-6 border-t border-red-500">
                  <p class="text-red-500 text-sm">
                    Dinletiyo Company  Ergili 2026
                  </p>
                </div>
              </div>
            </div>
          </div>
        </body>
        </html>
        `,
        { 
          status: 403,
          headers: { 'Content-Type': 'text/html; charset=utf-8' }
        }
      );
    }
  } catch (error) {
    console.error('IP ban kontrolü hatası:', error);
  }
  
  // Log request for anti-DDoS analysis
  await logRequest(ip, url, request.method, request.headers.get('user-agent') || '');
  
  // Add security headers
  const response = NextResponse.next();
  response.headers.set('X-Frame-Options', 'DENY');
  response.headers.set('X-Content-Type-Options', 'nosniff');
  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
  response.headers.set('X-Real-IP', ip);
  response.headers.set('X-Protected-By', 'Bozkurt Anti-DDoS');
  
  return response;
}

export const config = {
  matcher: [
    /*
     * Tüm route'ları kontrol et, sadece static dosyalar ve dev panelini hariç tut
     */
    '/((?!_next/static|_next/image|favicon.ico|dev).*)',
  ],
}